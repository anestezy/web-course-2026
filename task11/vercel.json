{
  "functions": {
    "api/index.js": {
      "includeFiles": "{server,node_modules/better-sqlite3}/**"
    }
  },
  "rewrites": [
    { "source": "/categories", "destination": "/api" },
    { "source": "/categories/:path*", "destination": "/api" },
    { "source": "/transactions", "destination": "/api" },
    { "source": "/transactions/:path*", "destination": "/api" },
    { "source": "/", "destination": "/client/index.html" },
    { "source": "/style.css", "destination": "/client/style.css" },
    { "source": "/js/:path*", "destination": "/client/js/:path*" }
  ]
}
